# Task Runner 环境变量
# 复制为 .env 并填入你的 key

# Task API
TASK_API_URL=https://task.sant.ltd/api/tasks

# 统一模型网关 (ai.sant.ltd LiteLLM proxy)
LITELLM_URL=https://ai.sant.ltd
LITELLM_API_KEY=sk-xxx

# 备用直连 (git.sant.ltd Anthropic 代理)
ANTHROPIC_BASE_URL=https://git.sant.ltd
ANTHROPIC_API_KEY=sk-git-xxx

# 默认模型
DEFAULT_MODEL=claude-sonnet-4-5

# 代码仓库
CODE_REPO_DIR=C:/Users/yuhaoliu/.craft-agent/workspaces/my-workspace/agent-platform
