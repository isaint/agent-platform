# Task Runner 环境变量
# 复制为 .env 并填入你的 key

# Task API
TASK_API_URL=https://task.sant.ltd/api/tasks

# LiteLLM (统一模型网关)
LITELLM_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-your-litellm-key

# 模型 API Keys
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
GEMINI_API_KEY=xxx

# 默认模型
DEFAULT_MODEL=gpt-4o

# 代码仓库
CODE_REPO_DIR=C:/Users/yuhaoliu/repos/agent-platform
